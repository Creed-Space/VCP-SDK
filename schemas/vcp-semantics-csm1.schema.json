{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vcp.creed.space/schema/csm1-code/v1.json",
  "title": "CSM1 Code Schema",
  "description": "JSON Schema for Constitutional Safety Minicode (CSM1) validation",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "The CSM1 code string",
      "pattern": "^(?![^:@]*(?:\\+F[^:@]*\\+A|\\+A[^:@]*\\+F|\\+V[^:@]*\\+A|\\+A[^:@]*\\+V|\\+H[^:@]*\\+A|\\+A[^:@]*\\+H))(?![^:@]*\\+([FWPETOVAHSR])(?:\\+[FWPETOVAHSR])*\\+\\1(?=\\+|[:@]|$))(?:C[0-5](?:\\+[FWPETOVAHSR])*:[A-Z]{1,8}|[NZGAMD][0-5](?:\\+[FWPETOVAHSR])*(?::[A-Z]{1,8})?)(?:@(?:(?:0|[1-9][0-9]{0,2})\\.(?:0|[1-9][0-9]{0,2})\\.(?:0|[1-9][0-9]{0,2})|latest|canary))?$",
      "minLength": 2,
      "maxLength": 45,
      "examples": [
        "N5",
        "N5+F",
        "N5+F+E",
        "Z4+P+W",
        "N5+F:ELEM@1.2.0",
        "C3+W:ACME"
      ]
    },
    "persona": {
      "type": "string",
      "description": "Persona code (single character)",
      "enum": [
        "N",
        "Z",
        "G",
        "A",
        "M",
        "D",
        "C"
      ]
    },
    "persona_name": {
      "type": "string",
      "description": "Full persona name",
      "enum": [
        "nanny",
        "sentinel",
        "godparent",
        "ambassador",
        "muse",
        "mediator",
        "custom"
      ]
    },
    "adherence": {
      "type": "integer",
      "description": "Adherence level (0-5)",
      "minimum": 0,
      "maximum": 5
    },
    "scopes": {
      "type": "array",
      "description": "Active scope codes",
      "items": {
        "type": "string",
        "enum": [
          "F",
          "W",
          "P",
          "E",
          "T",
          "O",
          "V",
          "A",
          "H",
          "S",
          "R"
        ]
      },
      "uniqueItems": true,
      "maxItems": 11
    },
    "namespace": {
      "oneOf": [
        {
          "type": "string",
          "description": "Custom namespace identifier",
          "pattern": "^[A-Z]{1,8}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "oneOf": [
        {
          "type": "string",
          "description": "Semantic version",
          "pattern": "^(?:0|[1-9][0-9]{0,2})\\.(?:0|[1-9][0-9]{0,2})\\.(?:0|[1-9][0-9]{0,2})$"
        },
        {
          "type": "string",
          "enum": [
            "latest",
            "canary"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical": {
      "type": "string",
      "description": "Canonical MICRO-tier serialization for hashing and comparison.",
      "pattern": "^(?![^:@]*(?:\\+F[^:@]*\\+A|\\+A[^:@]*\\+F|\\+V[^:@]*\\+A|\\+A[^:@]*\\+V|\\+H[^:@]*\\+A|\\+A[^:@]*\\+H))(?![^:@]*\\+([FWPETOVAHSR])(?:\\+[FWPETOVAHSR])*\\+\\1(?=\\+|[:@]|$))(?:C[0-5](?:\\+[FWPETOVAHSR])*:[A-Z]{1,8}|[NZGAMD][0-5](?:\\+[FWPETOVAHSR])*(?::[A-Z]{1,8})?)(?:@(?:(?:0|[1-9][0-9]{0,2})\\.(?:0|[1-9][0-9]{0,2})\\.(?:0|[1-9][0-9]{0,2})|latest|canary))?$",
      "minLength": 2,
      "maxLength": 45
    },
    "compact": {
      "type": "string",
      "description": "COMPACT representation with a bounded canonical UVC token and one or more scopes.",
      "pattern": "^CS1\\|(nanny|sentinel|godparent|ambassador|muse|mediator|custom)\\|[0-5]\\|[a-z][a-z0-9-]{0,31}(?:\\.[a-z][a-z0-9-]{0,31}){2,9}(?:@(?:[\\^~]?(?:0|[1-9][0-9]{0,4})\\.(?:0|[1-9][0-9]{0,4})\\.(?:0|[1-9][0-9]{0,4})|latest|canary))?(?::[A-Z][A-Z0-9]{0,31})?\\|[FWPETOVAHSR](?:,[FWPETOVAHSR])*$",
      "minLength": 18,
      "maxLength": 294
    }
  },
  "required": [
    "code",
    "persona",
    "adherence"
  ],
  "definitions": {
    "persona_definition": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "N",
            "Z",
            "G",
            "A",
            "M",
            "D",
            "C"
          ]
        },
        "name": {
          "type": "string"
        },
        "focus": {
          "type": "string"
        },
        "default_adherence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "compatible_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "incompatible_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "focus",
        "default_adherence",
        "compatible_scopes",
        "incompatible_scopes"
      ]
    },
    "scope_definition": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "F",
            "W",
            "P",
            "E",
            "T",
            "O",
            "V",
            "A",
            "H",
            "S",
            "R"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "description"
      ]
    },
    "adherence_level": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "name": {
          "type": "string",
          "enum": [
            "minimal",
            "relaxed",
            "moderate",
            "standard",
            "strict",
            "maximum"
          ]
        },
        "enforcement": {
          "type": "string"
        },
        "user_override": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "level",
        "name",
        "enforcement",
        "user_override"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "persona": {
            "const": "C"
          }
        }
      },
      "then": {
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "namespace"
        ]
      }
    },
    {
      "if": {
        "required": [
          "scopes"
        ],
        "properties": {
          "scopes": {
            "type": "array",
            "contains": {
              "const": "F"
            }
          }
        }
      },
      "then": {
        "properties": {
          "scopes": {
            "type": "array",
            "not": {
              "contains": {
                "const": "A"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "scopes"
        ],
        "properties": {
          "scopes": {
            "type": "array",
            "contains": {
              "const": "V"
            }
          }
        }
      },
      "then": {
        "properties": {
          "scopes": {
            "type": "array",
            "not": {
              "contains": {
                "const": "A"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "scopes"
        ],
        "properties": {
          "scopes": {
            "type": "array",
            "contains": {
              "const": "H"
            }
          }
        }
      },
      "then": {
        "properties": {
          "scopes": {
            "type": "array",
            "not": {
              "contains": {
                "const": "A"
              }
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "code": "N5+F+E",
      "persona": "N",
      "persona_name": "nanny",
      "adherence": 5,
      "scopes": [
        "F",
        "E"
      ],
      "namespace": null,
      "version": null
    },
    {
      "code": "Z4+P+W:SEC@1.0.0",
      "persona": "Z",
      "persona_name": "sentinel",
      "adherence": 4,
      "scopes": [
        "P",
        "W"
      ],
      "namespace": "SEC",
      "version": "1.0.0"
    },
    {
      "code": "C3+W+O:ACME",
      "persona": "C",
      "persona_name": "custom",
      "adherence": 3,
      "scopes": [
        "W",
        "O"
      ],
      "namespace": "ACME",
      "version": null
    }
  ],
  "additionalProperties": false
}
