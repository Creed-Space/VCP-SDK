{
  "name": "@creed-space/vcp-sdk",
  "version": "4.2.0",
  "description": "Register VCP capabilities as discoverable tools through the experimental WebMCP document.modelContext API",
  "homepage": "https://github.com/Creed-Space/VCP-SDK/tree/main/webmcp#readme",
  "bugs": {
    "url": "https://github.com/Creed-Space/VCP-SDK/issues"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./polyfill": {
      "types": "./dist/polyfill.d.ts",
      "import": "./dist/polyfill.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:packed": "node scripts/test-packed.mjs",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build && npm run check:package",
    "check:package": "node scripts/check-package.mjs"
  },
  "keywords": [
    "vcp",
    "webmcp",
    "mcp",
    "becoming-minds",
    "context-protocol",
    "document-modelcontext",
    "chrome-extensions",
    "constitutional-ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Creed-Space/VCP-SDK.git",
    "directory": "webmcp"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "webmcp-types": "0.1.3"
  },
  "allowScripts": {
    "fsevents": false
  }
}
