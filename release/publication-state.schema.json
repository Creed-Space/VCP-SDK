{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuecontextprotocol.org/schemas/publication-state-v1.json",
  "title": "VCP ecosystem publication state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "as_of",
    "authority",
    "overall_state",
    "candidate_names_ratified",
    "protocol",
    "conformance",
    "artifacts",
    "public_copy_policy"
  ],
  "properties": {
    "schema": { "const": "vcp-publication-state/1" },
    "as_of": { "type": "string", "format": "date" },
    "authority": { "type": "string", "minLength": 1 },
    "overall_state": {
      "enum": ["source-only", "candidate", "published", "yanked", "deprecated"]
    },
    "candidate_names_ratified": { "type": "boolean" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_baseline", "candidate", "candidate_maturity"],
      "properties": {
        "source_baseline": { "type": "string" },
        "candidate": { "type": "string" },
        "candidate_maturity": { "type": "string" }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_count",
        "case_count",
        "protocol_layer_count",
        "extension_suite_count",
        "full_project_controlled_implementations",
        "browser_integrations",
        "independent_implementations",
        "claim_boundary"
      ],
      "properties": {
        "fixture_count": { "type": "integer", "minimum": 0 },
        "case_count": { "type": "integer", "minimum": 0 },
        "protocol_layer_count": { "type": "integer", "minimum": 0 },
        "extension_suite_count": { "type": "integer", "minimum": 0 },
        "full_project_controlled_implementations": {
          "type": "integer",
          "minimum": 0
        },
        "browser_integrations": { "type": "integer", "minimum": 0 },
        "independent_implementations": { "type": "integer", "minimum": 0 },
        "claim_boundary": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "candidate_name",
          "import_name",
          "candidate_version",
          "registry",
          "state",
          "source_command",
          "source_commit",
          "registry_receipt"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "candidate_name": { "type": "string", "minLength": 1 },
          "import_name": { "type": "string", "minLength": 1 },
          "candidate_version": { "type": "string", "minLength": 1 },
          "registry": { "type": "string", "minLength": 1 },
          "state": {
            "enum": ["source-only", "candidate", "published", "yanked", "deprecated"]
          },
          "source_command": { "type": "string", "minLength": 1 },
          "source_commit": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{40}$"
          },
          "registry_receipt": {
            "type": ["string", "null"],
            "format": "uri"
          }
        }
      }
    },
    "public_copy_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_install_commands_allowed",
        "published_badges_allowed",
        "required_label",
        "publication_requirements"
      ],
      "properties": {
        "registry_install_commands_allowed": { "type": "boolean" },
        "published_badges_allowed": { "type": "boolean" },
        "required_label": { "type": "string", "minLength": 1 },
        "publication_requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
