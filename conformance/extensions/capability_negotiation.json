        "client_hello": {
          "type": "vcp-hello",
          "version": "3.x",
          "min_version": "1.0",
          "extensions": []
        },
        "server_capabilities": {
          "supported_versions": [
            "1.0",
            "2.0",
            "3.0",
            "3.1"
          ],
          "extensions": {
            "VCP-X-Personal": {
              "decay": true,
