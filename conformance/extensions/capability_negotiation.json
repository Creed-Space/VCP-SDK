            "encryption": true,
            "injection_scanning": true,
            "revocation": true,
            "audit_chain": true,
            "context_opacity": true
          }
        }
      }
    },
    {
      "id": "invalid-extension-identifiers-ignored",
      "description": "Unique bounded strings outside the VCP-X-* namespace are ignored before partitioning.",
