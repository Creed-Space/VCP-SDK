{
  "suite": "extensions/capability_negotiation",
  "version": "2.0.0",
  "schema_version": "1.0.0",
  "vcp_version": "3.1",
  "description": "Canonical VCP Hello/Ack version and extension negotiation vectors.",
  "test_cases": [
    {
      "id": "full-match",
      "description": "Highest mutual version activates every requested server extension and advertises only those capabilities.",
      "input": {
        "client_hello": {
          "type": "vcp-hello",
          "version": "3.1",
          "min_version": "1.0",
          "extensions": [
            "VCP-X-Personal",
            "VCP-X-Consensus",
            "VCP-X-Torch"
          ]
        },
        "server_capabilities": {
          "supported_versions": [
            "1.0",
            "2.0",
            "3.0",
            "3.1"
          ],
          "extensions": {
            "VCP-X-Personal": {
              "decay": true,
              "intensity_range": [
                1,
                5
              ]
            },
            "VCP-X-Consensus": {
              "voting_method": "schulze"
            },
            "VCP-X-Torch": {
              "lineage": true,
              "degraded": false
            }
          },
          "core_features": {
            "encryption": true,
            "injection_scanning": true,
            "revocation": true,
            "audit_chain": true,
            "context_opacity": true
          },
          "server_id": "server/4.2",
          "session_id": "ses_full"
        }
      },
      "expected": {
        "server_ack": {
          "type": "vcp-ack",
          "version": "3.1",
          "supported": [
            "VCP-X-Personal",
            "VCP-X-Consensus",
            "VCP-X-Torch"
          ],
          "unsupported": [],
          "capabilities": {
            "VCP-X-Personal": {
              "decay": true,
              "intensity_range": [
                1,
                5
              ]
            },
            "VCP-X-Consensus": {
              "voting_method": "schulze"
            },
            "VCP-X-Torch": {
              "lineage": true,
              "degraded": true
            }
          },
          "core_features": {
            "encryption": true,
            "injection_scanning": true,
            "revocation": true,
            "audit_chain": true,
            "context_opacity": true
          },
          "server_id": "server/4.2",
          "session_id": "ses_full"
        }
      }
    },
    {
      "id": "intent-without-personal-signals",
      "description": "An active Intent extension without active Personal advertises that personal signals are unavailable, overriding stale server configuration.",
      "input": {
        "client_hello": {
          "type": "vcp-hello",
          "version": "3.1",
          "min_version": "1.0",
          "extensions": [
            "VCP-X-Intent"
          ]
        },
        "server_capabilities": {
          "supported_versions": [
            "1.0",
            "2.0",
            "3.0",
            "3.1"
          ],
          "extensions": {
            "VCP-X-Intent": {
              "user_correction": true,
              "personal_signals": true
            }
          },
          "core_features": {
            "encryption": true,
            "injection_scanning": true,
            "revocation": true,
            "audit_chain": true,
            "context_opacity": true
          }
        }
      },
      "expected": {
        "server_ack": {
          "type": "vcp-ack",
          "version": "3.1",
          "supported": [
            "VCP-X-Intent"
          ],
          "unsupported": [],
          "capabilities": {
            "VCP-X-Intent": {
              "user_correction": true,
              "personal_signals": false
            }
          },
          "core_features": {
            "encryption": true,
            "injection_scanning": true,
            "revocation": true,
            "audit_chain": true,
            "context_opacity": true
          }
        }
      }
    },
    {
      "id": "partial-partition",
      "description": "Supported and unsupported are a disjoint, client-order partition of valid requested extensions.",
      "input": {
        "client_hello": {
          "type": "vcp-hello",
          "version": "3.1",
          "min_version": "1.0",
          "extensions": [
            "VCP-X-Relational",
            "VCP-X-Personal",
            "VCP-X-Intent",
            "VCP-X-Consensus"
          ]
        },
        "server_capabilities": {
          "supported_versions": [
            "1.0",
            "2.0",
            "3.0",
            "3.1"
          ],
          "extensions": {
            "VCP-X-Personal": {
              "decay": true,
              "intensity_range": [
                1,
                5
              ]
            },
            "VCP-X-Consensus": {
              "voting_method": "schulze"
            },
            "VCP-X-Torch": {
              "lineage": true
            }
          },
          "core_features": {
            "encryption": true,
            "injection_scanning": true,
            "revocation": true,
            "audit_chain": true,
            "context_opacity": true
          }
        }
      },
      "expected": {
        "server_ack": {
          "type": "vcp-ack",
          "version": "3.1",
          "supported": [
            "VCP-X-Personal",
            "VCP-X-Consensus"
          ],
          "unsupported": [
            "VCP-X-Relational",
            "VCP-X-Intent"
          ],
          "capabilities": {
            "VCP-X-Personal": {
              "decay": true,
              "intensity_range": [
                1,
                5
              ]
            },
            "VCP-X-Consensus": {
              "voting_method": "schulze"
            }
          },
          "core_features": {
            "encryption": true,
            "injection_scanning": true,
            "revocation": true,
            "audit_chain": true,
            "context_opacity": true
          }
        }
      }
    },
    {
      "id": "downgrade-disables-extensions",
      "description": "A mutually supported version below 3.1 keeps every valid request in unsupported.",
      "input": {
        "client_hello": {
          "type": "vcp-hello",
          "version": "3.1",
          "min_version": "3.0",
          "extensions": [
            "VCP-X-Personal",
            "VCP-X-Torch"
          ]
        },
        "server_capabilities": {
          "supported_versions": [
            "1.0",
            "2.0",
            "3.0"
          ],
          "extensions": {
            "VCP-X-Personal": {
              "decay": true,
              "intensity_range": [
                1,
                5
              ]
            },
            "VCP-X-Consensus": {
              "voting_method": "schulze"
            },
            "VCP-X-Torch": {
              "lineage": true
            }
          },
          "core_features": {
            "encryption": true,
            "injection_scanning": true,
            "revocation": true,
            "audit_chain": true,
            "context_opacity": true
          }
        }
      },
      "expected": {
        "server_ack": {
          "type": "vcp-ack",
          "version": "3.0",
          "supported": [],
          "unsupported": [
            "VCP-X-Personal",
            "VCP-X-Torch"
          ],
          "capabilities": {},
          "core_features": {
            "encryption": true,
            "injection_scanning": true,
            "revocation": true,
            "audit_chain": true,
            "context_opacity": true
          }
        }
      }
    },
    {
      "id": "no-version-overlap",
      "description": "A client range below every server version produces the canonical VERSION_UNSUPPORTED error.",
      "input": {
        "client_hello": {
          "type": "vcp-hello",
          "version": "1.0",
          "min_version": "1.0",
          "extensions": [
            "VCP-X-Personal"
          ]
        },
        "server_capabilities": {
          "supported_versions": [
            "2.0",
            "3.0",
            "3.1"
          ],
          "extensions": {
            "VCP-X-Personal": {
              "decay": true,
              "intensity_range": [
                1,
                5
              ]
            },
            "VCP-X-Consensus": {
              "voting_method": "schulze"
            },
            "VCP-X-Torch": {
              "lineage": true
            }
          },
          "core_features": {
            "encryption": true,
            "injection_scanning": true,
            "revocation": true,
            "audit_chain": true,
            "context_opacity": true
          }
        }
      },
      "expected": {
        "server_ack": {
          "type": "vcp-error",
          "code": "VERSION_UNSUPPORTED",
          "message": "No mutually supported VCP version",
          "supported_versions": [
            "2.0",
            "3.0",
            "3.1"
          ],
          "retry_after": null
        }
      }
    },
    {
      "id": "empty-extension-request",
      "description": "An empty request activates no extension even when the server advertises several.",
      "input": {
        "client_hello": {
          "type": "vcp-hello",
          "version": "3.1",
          "min_version": "1.0",
          "extensions": []
        },
        "server_capabilities": {
          "supported_versions": [
            "1.0",
            "2.0",
            "3.0",
            "3.1"
          ],
          "extensions": {
            "VCP-X-Personal": {
              "decay": true,
