{
  "suite": "adaptation/messaging",
  "version": "2.0.0",
  "schema_version": "1.0.0",
  "vcp_version": "2.0.0",
  "implementation_profile": "vcp-inter-agent-messaging-2.0",
  "description": "Checked VCP Inter-Agent Messaging v2.0 envelope validation vectors. This suite is intentionally separate from the VCP 3.1 context-envelope state machine.",
  "test_cases": [
    {
      "id": "msg-context-share",
      "description": "Valid context-share envelope",
      "input": {
        "vcp_message": "2.0",
        "type": "context_share",
        "message_id": "018d5f2a-7b3c-4d5e-8f90-123456789abc",
        "sender": "agent-alpha",
        "recipient": "agent-beta",
        "timestamp": "2026-01-10T12:00:00Z",
        "payload": {
          "context": "T:morning|S:office"
        }
      },
      "expected": {
        "valid": true,
        "error_codes": []
      }
    },
    {
      "id": "msg-constitution-announce",
      "description": "Valid constitution announcement",
      "input": {
        "vcp_message": "2.0",
        "type": "constitution_announce",
        "message_id": "018d5f2a-7b3c-4d5e-8f90-123456789abc",
        "sender": "agent-alpha",
        "recipient": "broadcast",
        "timestamp": "2026-01-10T12:00:00Z",
        "payload": {
          "constitution_ref": "creed://creed.space/professional@1.0.0"
        }
      },
      "expected": {
        "valid": true,
        "error_codes": []
      }
    },
    {
      "id": "msg-constraint-propagate",
      "description": "Valid constraint propagation",
      "input": {
        "vcp_message": "2.0",
        "type": "constraint_propagate",
        "message_id": "018d5f2a-7b3c-4d5e-8f90-123456789abc",
        "sender": "agent-alpha",
        "recipient": "agent-beta",
        "timestamp": "2026-01-10T12:00:00Z",
        "payload": {
          "constraints": [
            "do_not_disclose"
          ]
        }
      },
      "expected": {
        "valid": true,
        "error_codes": []
      }
    },
    {
      "id": "msg-escalation-info",
      "description": "Informational escalation does not require acknowledgement",
      "input": {
        "vcp_message": "2.0",
        "type": "escalation",
        "message_id": "018d5f2a-7b3c-4d5e-8f90-123456789abc",
        "sender": "agent-alpha",
        "recipient": "agent-beta",
        "timestamp": "2026-01-10T12:00:00Z",
        "payload": {
          "severity": "info",
          "requires_ack": false
        }
      },
      "expected": {
        "valid": true,
        "error_codes": []
      }
    },
    {
      "id": "msg-escalation-critical",
      "description": "Critical escalation explicitly requires acknowledgement",
      "input": {
        "vcp_message": "2.0",
        "type": "escalation",
        "message_id": "018d5f2a-7b3c-4d5e-8f90-123456789abc",
        "sender": "agent-alpha",
        "recipient": "agent-beta",
        "timestamp": "2026-01-10T12:00:00Z",
        "payload": {
          "severity": "critical",
          "requires_ack": true
        }
      },
      "expected": {
        "valid": true,
        "error_codes": []
      }
    },
    {
      "id": "msg-err-missing-sender",
      "description": "Missing required sender is rejected",
      "input": {
        "vcp_message": "2.0",
        "type": "context_share",
        "message_id": "018d5f2a-7b3c-4d5e-8f90-123456789abc",
        "recipient": "agent-beta",
        "timestamp": "2026-01-10T12:00:00Z",
        "payload": {
          "context": "T:morning|S:office"
        }
      },
      "expected": {
        "valid": false,
        "error_codes": [
          "missing_sender"
        ]
      }
    },
    {
      "id": "msg-err-invalid-type",
      "description": "Unknown message type is rejected",
      "input": {
        "vcp_message": "2.0",
        "type": "state_update",
        "message_id": "018d5f2a-7b3c-4d5e-8f90-123456789abc",
        "sender": "agent-alpha",
        "recipient": "agent-beta",
        "timestamp": "2026-01-10T12:00:00Z",
        "payload": {
          "context": "T:morning|S:office"
        }
      },
      "expected": {
        "valid": false,
        "error_codes": [
          "invalid_type"
        ]
      }
    },
    {
      "id": "msg-err-version",
      "description": "Protocol-major mismatch is rejected",
      "input": {
        "vcp_message": "3.0",
        "type": "context_share",
        "message_id": "018d5f2a-7b3c-4d5e-8f90-123456789abc",
        "sender": "agent-alpha",
        "recipient": "agent-beta",
        "timestamp": "2026-01-10T12:00:00Z",
        "payload": {
          "context": "T:morning|S:office"
        }
      },
      "expected": {
        "valid": false,
        "error_codes": [
          "invalid_version"
        ]
      }
    },
    {
      "id": "msg-err-uuid",
      "description": "Malformed message identifier is rejected",
      "input": {
        "vcp_message": "2.0",
        "type": "context_share",
        "message_id": "not-a-uuid",
        "sender": "agent-alpha",
        "recipient": "agent-beta",
        "timestamp": "2026-01-10T12:00:00Z",
        "payload": {
          "context": "T:morning|S:office"
        }
      },
      "expected": {
        "valid": false,
        "error_codes": [
          "invalid_message_id"
        ]
      }
    },
    {
      "id": "msg-err-naive-time",
      "description": "Timestamp without timezone is rejected",
      "input": {
        "vcp_message": "2.0",
        "type": "context_share",
        "message_id": "018d5f2a-7b3c-4d5e-8f90-123456789abc",
        "sender": "agent-alpha",
        "recipient": "agent-beta",
        "timestamp": "2026-01-10T12:00:00",
        "payload": {
          "context": "T:morning|S:office"
        }
      },
      "expected": {
        "valid": false,
        "error_codes": [
          "invalid_timestamp"
        ]
      }
    },
    {
      "id": "msg-err-non-utc-time",
      "description": "Timestamp with a non-UTC offset is rejected",
      "input": {
        "vcp_message": "2.0",
        "type": "context_share",
        "message_id": "018d5f2a-7b3c-4d5e-8f90-123456789abc",
        "sender": "agent-alpha",
        "recipient": "agent-beta",
        "timestamp": "2026-01-10T13:00:00+01:00",
        "payload": {
          "context": "T:morning|S:office"
        }
      },
      "expected": {
        "valid": false,
        "error_codes": [
          "invalid_timestamp"
        ]
      }
    },
    {
      "id": "msg-err-critical-ack",
      "description": "Critical escalation without acknowledgement is rejected",
      "input": {
        "vcp_message": "2.0",
        "type": "escalation",
        "message_id": "018d5f2a-7b3c-4d5e-8f90-123456789abc",
        "sender": "agent-alpha",
        "recipient": "agent-beta",
        "timestamp": "2026-01-10T12:00:00Z",
        "payload": {
          "severity": "critical",
          "requires_ack": false
        }
      },
      "expected": {
        "valid": false,
        "error_codes": [
          "ack_required"
        ]
      }
    },
    {
      "id": "msg-err-severity",
      "description": "Unknown escalation severity is rejected",
      "input": {
        "vcp_message": "2.0",
        "type": "escalation",
        "message_id": "018d5f2a-7b3c-4d5e-8f90-123456789abc",
        "sender": "agent-alpha",
        "recipient": "agent-beta",
        "timestamp": "2026-01-10T12:00:00Z",
        "payload": {
          "severity": "catastrophic",
          "requires_ack": true
        }
      },
      "expected": {
        "valid": false,
        "error_codes": [
          "invalid_severity"
        ]
      }
    },
    {
      "id": "msg-err-payload",
      "description": "Non-object payload is rejected",
      "input": {
        "vcp_message": "2.0",
        "type": "context_share",
        "message_id": "018d5f2a-7b3c-4d5e-8f90-123456789abc",
        "sender": "agent-alpha",
        "recipient": "agent-beta",
        "timestamp": "2026-01-10T12:00:00Z",
        "payload": [
          "not",
          "an",
          "object"
        ]
      },
      "expected": {
        "valid": false,
        "error_codes": [
          "invalid_payload"
        ]
      }
    }
  ]
}
