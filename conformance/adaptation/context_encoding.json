{
  "suite": "adaptation/context_encoding",
  "version": "3.2.0",
  "description": "VCP v3.2 context encoding and decoding vectors. Situational dimensions use pipe-separated symbol and value groups. Personal-state dimensions use canonical field names with value and intensity (1-5). U+2016 DOUBLE VERTICAL LINE separates the situational and personal bands.",
  "vectors": [
    {
      "id": "ctx-001",
      "description": "Empty context: no dimensions set",
      "input": {
        "situational": {},
        "personal": {}
      },
      "expected": {
        "wire": "",
        "has_any": false
      }
    },
    {
      "id": "ctx-002",
      "description": "Situational only: time dimension with sunrise emoji",
      "input": {
        "situational": {
          "time": [
            "\ud83c\udf05"
          ]
        },
        "personal": {}
      },
      "expected": {
        "wire_contains": "\u23f0",
        "wire_does_not_contain": "\u2016",
        "has_situational": true,
        "has_personal": false,
        "note": "The personal-band separator U+2016 is absent when personal state is empty."
      }
    },
    {
      "id": "ctx-003",
      "description": "Personal only: cognitive dimension",
      "input": {
        "situational": {},
        "personal": {
          "cognitive_state": {
            "value": "focused",
            "intensity": 4
          }
        }
      },
      "expected": {
        "wire": "\u2016\ud83e\udde0focused:4",
        "wire_starts_with": "\u2016",
        "has_situational": false,
        "has_personal": true,
        "personal_cognitive_state_value": "focused",
        "note": "Personal-only wire starts with the U+2016 band separator."
      }
    },
    {
      "id": "ctx-004",
      "description": "Full roundtrip: situational time + space, personal cognitive + emotional",
      "input": {
        "situational": {
          "time": [
            "\ud83c\udf05"
          ],
          "space": [
            "\ud83c\udfe1"
          ]
        },
        "personal": {
          "cognitive_state": {
            "value": "focused",
            "intensity": 4
          },
          "emotional_tone": {
            "value": "calm",
            "intensity": 3
          }
        }
      },
      "expected": {
        "wire": "\u23f0\ud83c\udf05|\ud83d\udccd\ud83c\udfe1\u2016\ud83e\udde0focused:4|\ud83d\udcadcalm:3",
        "wire_contains": "\u2016",
        "has_situational": true,
        "has_personal": true,
        "roundtrip_preserves_time": true,
        "roundtrip_preserves_space": true,
        "roundtrip_cognitive_state_value": "focused",
        "roundtrip_emotional_tone_value": "calm"
      }
    },
    {
      "id": "ctx-005",
      "description": "Parse empty wire string",
      "wire_input": "",
      "expected": {
        "has_any": false,
        "has_situational": false,
        "has_personal": false
      }
    },
    {
      "id": "ctx-006",
      "description": "Serde roundtrip: context survives JSON serialization and deserialization",
      "input": {
        "situational": {
          "company": [
            "\ud83d\udc54"
          ]
        },
        "personal": {
          "perceived_urgency": {
            "value": "pressured",
            "intensity": 4
          }
        }
      },
      "expected": {
        "json_roundtrip": true,
        "note": "JSON roundtrip preserves the canonical perceived_urgency value and intensity."
      }
    },
    {
      "id": "ctx-007",
      "description": "Context with all nine core situational dimensions",
      "input": {
        "situational": {
          "time": [
            "\ud83c\udf05"
          ],
          "space": [
            "\ud83c\udfe1"
          ],
          "company": [
            "\ud83d\udc76"
          ],
          "culture": [
            "\ud83d\udce2"
          ],
          "occasion": [
            "\u2796"
          ],
          "environment": [
            "\ud83c\udf27\ufe0f"
          ],
          "agency": [
            "\ud83d\udc51"
          ],
          "constraints": [
            "\u25cb"
          ],
          "system_context": [
            "\ud83d\udcbb"
          ]
        },
        "personal": {}
      },
      "expected": {
        "has_situational": true,
        "has_personal": false
      }
    },
    {
      "id": "ctx-008",
      "description": "Emergency context: contains emergency indicators",
      "input": {
        "situational": {
          "occasion": [
            "\ud83d\udea8"
          ],
          "constraints": [
            "\ud83d\udea8"
          ]
        },
        "personal": {}
      },
      "expected": {
        "has_emergency": true,
        "note": "The alarm emoji in OCCASION or CONSTRAINTS indicates an emergency context"
      }
    },
    {
      "id": "ctx-009",
      "description": "Children present indicator",
      "input": {
        "situational": {
          "space": [
            "\ud83c\udfe1"
          ],
          "company": [
            "\ud83d\udc76"
          ]
        },
        "personal": {}
      },
      "expected": {
        "has_children": true,
        "note": "Baby emoji in COMPANY dimension indicates children are present"
      }
    },
    {
      "id": "ctx-010",
      "description": "Canonical CULTURE and SYSTEM_CONTEXT vocabularies (VCP/A 2.1)",
      "input": {
        "situational": {
          "culture": [
            "\ud83d\udcca",
            "\ud83d\udc65"
          ],
          "system_context": [
            "\ud83d\udc41\ufe0f"
          ]
        },
        "personal": {}
      },
      "expected": {
        "wire": "\ud83c\udf0d\ud83d\udcca\ud83d\udc65|\ud83d\udce1\ud83d\udc41\ufe0f",
        "has_situational": true,
        "has_personal": false,
        "has_vep_0004": false,
        "conformance_level": "VCP-Minimal",
        "note": "CULTURE carries communication styles (hierarchical, collectivist); SYSTEM_CONTEXT carries the computing environment (monitored_environment). The retired online/degraded/offline/sandboxed/testing and casual/mixed values are not canonical."
      }
    },
    {
      "id": "ctx-011",
      "description": "Unknown values and unknown dimension groups are tolerated and passed through (VCP/A 2.3)",
      "wire_input": "\u23f0\ud83c\udf05|\ud83c\udfad\ud83d\ude22|\ud83e\udd84sparkle\u2016\ud83e\udde0focused:4|\ud83e\ude90orbit:2",
      "expected": {
        "wire": "\u23f0\ud83c\udf05|\ud83c\udfad\ud83d\ude22|\ud83e\udd84sparkle\u2016\ud83e\udde0focused:4|\ud83e\ude90orbit:2",
        "has_situational": true,
        "has_personal": true,
        "has_vep_0004": false,
        "conformance_level": "VCP-Standard",
        "note": "\ud83d\ude22 is not an OCCASION value in VCP/A 2.2 and is kept as written. \ud83e\udd84 and \ud83e\ude90 are not dimension symbols, so their groups are kept, ignored for adaptation, and re-encoded after the known dimensions. A strict validator reports all three."
      }
    },
    {
      "id": "ctx-012",
      "description": "A malformed context string is still rejected: empty group",
      "wire_input": "\u23f0\ud83c\udf05||\ud83d\udccd\ud83c\udfe1",
      "expected": {
        "valid": false,
        "note": "An empty group is a validation error, not an unknown value (VCP/A 2.3)."
      }
    },
    {
      "id": "ctx-013",
      "description": "Personal-only context begins with the separator (VCP/A 2.3)",
      "wire_input": "\u2016\ud83e\udde0focused:4|\ud83d\udcadcalm:5",
      "expected": {
        "wire": "\u2016\ud83e\udde0focused:4|\ud83d\udcadcalm:5",
        "has_situational": false,
        "has_personal": true,
        "conformance_level": "VCP-Standard",
        "note": "A string with personal state only begins with U+2016 and has no situational band."
      }
    },
    {
      "id": "ctx-014",
      "description": "Intensity with a leading zero is malformed",
      "wire_input": "\u2016\ud83e\udde0focused:04",
      "expected": {
        "valid": false,
        "note": "An intensity is exactly one digit from 1 to 5; 04, 0 and 6 are malformed (VCP/A 2.3), not unknown values."
      }
    }
  ]
}
